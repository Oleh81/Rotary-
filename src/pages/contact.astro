---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import Form from '../components/Form.astro';
import { org } from '../data/site';
import { img } from '../lib/img';
const steps = ['Exit Highway 1 to Lougheed Highway (#7) and turn left at the Colony Farm Road entrance to Riverview.', 'Turn right at Cape Horn Avenue, then left onto Holly Drive at the first stop sign.', 'Stay on Holly Drive until you reach a five-way stop.', 'Take the furthest left turn onto Oak Crescent, go past Boxwood Drive on the left, then take the next left onto Kerrina Drive.', 'A short way down Kerrina Drive, Thistle Place is on the right. The RWH warehouse is about 500 yards along it.'];
---
<Layout title="Contact" overlay description="Contact Rotary World Help: warehouse at Thistle Place, Riverview grounds, Coquitlam BC; mailing address in Burnaby; email and phone.">
  <PageHero page="contact" eyebrow="Contact" title="Come and see the warehouse." lead="Questions about donations, membership, aid requests or volunteering at a loading? We would love to hear from you." />
  <section class="py-20 md:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.1fr]">
      <div class="min-w-0 space-y-5">
        <a href={`mailto:${org.email}`} class="reveal group card-lift flex items-center gap-5 rounded-3xl bg-white p-6 ring-1 ring-line">
          <span class="grid size-14 place-items-center rounded-2xl bg-sky text-royal transition-colors group-hover:bg-royal group-hover:text-white"><Icon name="mail" size={24} /></span>
          <span class="min-w-0"><span class="block text-sm text-stone">Email</span><span class="font-display text-xl sm:text-2xl [overflow-wrap:anywhere]">{org.email}</span></span>
        </a>
        <a href={org.phoneHref} class="reveal group card-lift flex items-center gap-5 rounded-3xl bg-white p-6 ring-1 ring-line" style="--d:1">
          <span class="grid size-14 place-items-center rounded-2xl bg-sky text-royal transition-colors group-hover:bg-royal group-hover:text-white"><Icon name="phone" size={24} /></span>
          <span><span class="block text-sm text-stone">Phone</span><span class="font-display text-2xl tabular">{org.phone}</span></span>
        </a>
        <div class="reveal grid gap-5 sm:grid-cols-2" style="--d:2">
          <div class="rounded-3xl bg-ink p-6 text-white on-dark">
            <Icon name="pin" size={22} class="text-gold" />
            <h2 class="mt-3 font-semibold">Warehouse</h2>
            <address class="mt-2 not-italic text-white/80 leading-relaxed">{org.warehouse.lines.map(l => <>{l}<br /></>)}</address>
            <p class="mt-3 text-sm text-white/60">GPS: enter “Thistle Place, Coquitlam, BC”.</p>
            <a href={org.warehouse.maps} target="_blank" rel="noopener" class="link-arrow mt-3 text-gold">Open in Google Maps <Icon name="arrow-up-right" size={16} /></a>
          </div>
          <div class="rounded-3xl bg-white p-6 ring-1 ring-line">
            <Icon name="mail" size={22} class="text-royal" />
            <h2 class="mt-3 font-semibold">Mailing address</h2>
            <address class="mt-2 not-italic text-stone leading-relaxed">{org.mailing.map(l => <>{l}<br /></>)}</address>
          </div>
        </div>
        <div class="reveal rounded-3xl bg-white p-6 ring-1 ring-line" style="--d:3">
          <h2 class="font-semibold">Reach the right person</h2>
          <ul class="mt-3 grid gap-2 text-stone">
            {[['President', 'president@rotaryworldhelp.com'], ['Shipping', 'shipping@rotaryworldhelp.com'], ['Treasurer, for a major financial donation', 'treasurer@rotaryworldhelp.com']].map(([r, e]) => (
              <li class="flex flex-wrap justify-between gap-x-4"><span>{r}</span><a class="font-semibold text-royal underline [overflow-wrap:anywhere]" href={`mailto:${e}`}>{e}</a></li>
            ))}
          </ul>
        </div>
        <details class="reveal group rounded-3xl bg-white p-6 ring-1 ring-line" style="--d:3">
          <summary class="flex cursor-pointer list-none items-center justify-between font-semibold">Driving directions to the warehouse <Icon name="chevron" size={18} class="transition-transform group-open:rotate-180" /></summary>
          <ol class="mt-4 grid gap-3 text-stone">{steps.map((s, i) => <li class="flex gap-3"><span class="grid size-7 shrink-0 place-items-center rounded-full bg-sky text-sm font-bold text-royal">{i + 1}</span>{s}</li>)}</ol>
          <a href={img('1101')?.large} data-lightbox="map" data-caption="Riverview site map" class="mt-5 block overflow-hidden rounded-2xl ring-1 ring-line"><Img id="1101" alt="Map of the Riverview grounds showing the Rotary World Help warehouse on Thistle Place" class="w-full" sizes="(min-width:1024px) 36rem, 100vw" /></a>
        </details>
      </div>
      <div class="reveal rounded-[2rem] bg-white p-7 ring-1 ring-line md:p-10" style="--d:1">
        <h2 class="font-display text-3xl">Send us a message</h2>
        <Form kind="contact" class="mt-6 grid gap-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="field"><label for="c-first">First name</label><input id="c-first" name="first_name" autocomplete="given-name" class="input" /></div>
            <div class="field"><label for="c-last">Last name</label><input id="c-last" name="last_name" autocomplete="family-name" class="input" /></div>
          </div>
          <div class="field"><label for="c-email">Email address <span class="text-[#b42318]">*</span></label><input id="c-email" name="email" type="email" required autocomplete="email" class="input" /></div>
          <div class="field"><label for="c-phone">Phone number</label><input id="c-phone" name="phone" type="tel" autocomplete="tel" class="input" /></div>
          <div class="field"><label for="c-topic">Topic</label>
            <select id="c-topic" name="topic" class="input"><option>General question</option><option>Donating equipment</option><option>Monetary donation</option><option>Club membership</option><option>Requesting aid</option><option>Volunteering</option></select></div>
          <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="message" maxlength="2000" class="input"></textarea></div>
          <button type="submit" class="btn btn-primary">Send message <Icon name="arrow" size={18} class="arrow" /></button>
        </Form>
      </div>
    </div>
  </section>
</Layout>
