---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Img from '../../components/Img.astro';
import VideoCard from '../../components/VideoCard.astro';
import { news, excerpt } from '../../lib/cms';
import { img, hasImg } from '../../lib/img';
import { DONATE_URL } from '../../data/site';
export function getStaticPaths() { return news.map((n, i) => ({ params: { slug: n.slug }, props: { i } })); }
const { i } = Astro.props as { i: number };
const post = news[i];
const prev = news[i + 1]; const next = news[i - 1];
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });
const gallery = post.images.filter(p => hasImg(p.src) && p.src !== post.image);
const desc = excerpt(post, 155);
---
<Layout title={post.title} description={desc} image={hasImg(post.image) ? img(post.image)!.src : undefined}>
  <article>
    <header class="wrap max-w-4xl pt-14 md:pt-20">
      <a href="/news" class="link-arrow text-sm fade-up"><Icon name="chevron-left" size={16} /> All news</a>
      <time datetime={post.date} class="mt-8 block text-sm font-bold uppercase tracking-wider text-royal fade-up" style="--delay:.1s">{fmt(post.date)}</time>
      <h1 class="mt-3 font-display text-[clamp(2.2rem,5vw,4rem)] leading-[1.05] tracking-tight fade-up" style="--delay:.2s">{post.title}</h1>
    </header>
    {hasImg(post.image) && (
      <div class="wrap max-w-5xl mt-10"><div class="clip-in overflow-hidden rounded-[1.75rem]"><Img id={post.image} alt={post.imageAlt} eager class="max-h-[70vh] w-full object-cover" sizes="(min-width:1024px) 64rem, 100vw" /></div></div>
    )}
    <div class="wrap max-w-3xl py-12 md:py-16">
      {post.youtube && (
        <div class="mb-10 relative aspect-video overflow-hidden rounded-3xl bg-ink">
          <img src={`https://i.ytimg.com/vi/${post.youtube}/hqdefault.jpg`} alt="" class="absolute inset-0 h-full w-full object-cover opacity-80" loading="lazy" width="480" height="360" />
          <a href={`https://www.youtube.com/watch?v=${post.youtube}`} target="_blank" rel="noopener" class="absolute inset-0 grid place-items-center" aria-label="Watch the video on YouTube">
            <span class="grid size-20 place-items-center rounded-full bg-white text-ink shadow-2xl transition-transform duration-500 hover:scale-110"><Icon name="play" size={30} /></span>
          </a>
        </div>
      )}
      {post.videos.map(v => <div class="mb-10"><VideoCard id={v} /></div>)}
      <div class="prose-rwh" set:html={post.html} />
      {gallery.length > 0 && (
        <section class="mt-14" aria-label="Photos">
          <h2 class="font-display text-2xl">Photos</h2>
          <ul class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3">
            {gallery.map((ph, k) => (
              <li class="reveal-scale" style={`--d:${k % 3}`}><a href={img(ph.src)!.large} data-lightbox="post" data-caption={ph.caption || post.title} data-alt={ph.caption || `${post.title}, photo ${k + 1}`} class="group block overflow-hidden rounded-2xl">
                <Img id={ph.src} alt={ph.caption || `${post.title}, photo ${k + 1}`} class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105" sizes="(min-width:640px) 16rem, 50vw" />
              </a></li>
            ))}
          </ul>
        </section>
      )}
      <aside class="mt-16 flex flex-col gap-4 rounded-3xl bg-ink p-8 text-white on-dark sm:flex-row sm:items-center sm:justify-between">
        <p class="font-display text-2xl">Help ship the next container.</p>
        <a href={DONATE_URL} target="_blank" rel="noopener" class="btn btn-donate shimmer shrink-0"><Icon name="heart" size={18} /> Donate</a>
      </aside>
      <nav aria-label="More news" class="mt-10 grid gap-4 sm:grid-cols-2">
        {prev ? <a href={`/news/${prev.slug}`} class="group rounded-2xl p-5 ring-1 ring-line hover:bg-white transition-colors"><span class="text-sm text-stone">Older</span><span class="mt-1 block font-semibold group-hover:text-royal">{prev.title}</span></a> : <span></span>}
        {next && <a href={`/news/${next.slug}`} class="group rounded-2xl p-5 text-right ring-1 ring-line hover:bg-white transition-colors"><span class="text-sm text-stone">Newer</span><span class="mt-1 block font-semibold group-hover:text-royal">{next.title}</span></a>}
      </nav>
    </div>
  </article>
</Layout>
