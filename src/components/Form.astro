---
interface Props { kind: string; class?: string; dark?: boolean; compact?: boolean; submitLabel?: string }
const { kind, class: cls = '', dark = false, compact = false } = Astro.props;
---
<form method="post" action="/api/submit" class={`rwh-form ${cls}`} data-form={kind} novalidate>
  <input type="hidden" name="kind" value={kind} />
  <input type="hidden" name="t" value="" />
  <div class="hp" aria-hidden="true">
    <label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <slot />
  <div class={`form-status ${compact ? 'mt-3' : 'mt-5'} text-sm font-semibold empty:hidden ${dark ? 'text-gold' : 'text-royal'}`} role="status" aria-live="polite"></div>
  {!compact && <p class={`mt-3 text-xs ${dark ? 'text-white/50' : 'text-stone'}`}>Demo site: messages are validated and protected against spam, but are not yet delivered to Rotary World Help. Please email <a class="underline" href="mailto:info@rotaryworldhelp.com">info@rotaryworldhelp.com</a> for anything urgent.</p>}
</form>
