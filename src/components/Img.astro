---
import { img } from '../lib/img';
interface Props { id: string | null | undefined; alt: string; sizes?: string; class?: string; eager?: boolean; style?: string }
const { id, alt, sizes = '(min-width: 1024px) 50vw, 100vw', class: cls = '', eager = false, style } = Astro.props;
const i = img(id);
---
{i && <img src={i.src} srcset={i.srcset} sizes={sizes} width={i.width} height={i.height} alt={alt} class={cls} style={style}
  loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} referrerpolicy={id?.startsWith('drive:') ? 'no-referrer' : undefined} />}
