---
// Looping cartoon: volunteers wheel hospital beds, wheelchairs and boxes from the warehouse into a 40-foot container.
// Pure SVG + CSS. Plays only while on screen (main.ts adds .live); stands still for reduced motion.
const workers = [
  { cargo: 'bed', delay: 0, lane: 0, skin: '#f1c7a5', hat: '#f7a81b', vest: '#f97316' },
  { cargo: 'box', delay: -3.5, lane: 1, skin: '#8d5a3b', hat: '#ffffff', vest: '#1d5bb8' },
  { cargo: 'chair', delay: -7, lane: 0, skin: '#d9a77c', hat: '#f7a81b', vest: '#f97316' },
  { cargo: 'truck', delay: -10.5, lane: 1, skin: '#5c3a26', hat: '#f7a81b', vest: '#16a34a' },
];
const lanes = [{ y: 298, s: 1.22 }, { y: 288, s: 1.1 }];
const order = [...workers].sort((a, b) => b.lane - a.lane); // back lane first
---
<div class="cartoon" data-cartoon>
  <svg viewBox="0 0 720 330" class="block h-auto w-full" role="img" aria-labelledby="cartoon-t">
    <title id="cartoon-t">Animated illustration: volunteers wheel hospital beds, wheelchairs and boxes of medical supplies from the Rotary World Help warehouse into a 40-foot container</title>
    <defs>
      <linearGradient id="ct-sky" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#dbeafe" /><stop offset="1" stop-color="#f6f1e7" /></linearGradient>
      <linearGradient id="ct-box" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#1d5bb8" /><stop offset="1" stop-color="#123b7a" /></linearGradient>
      <g id="ct-carton"><rect width="18" height="15" rx="1.5" fill="#c99a5b" /><rect x="7" width="4" height="15" fill="#b5864a" /><rect x="3" y="5" width="6" height="5" rx="1" fill="#fff" /><path d="M6 6v3M4.5 7.5h3" stroke="#b42318" stroke-width="1.4" /></g>
    </defs>

    <!-- sky, sun, mountains, clouds -->
    <rect width="720" height="330" fill="url(#ct-sky)" />
    <circle cx="610" cy="62" r="26" fill="#f7a81b" opacity=".85" />
    <path d="M0 210 L70 140 L120 182 L190 108 L262 190 L330 132 L410 200 L480 120 L560 196 L630 146 L720 206 V330 H0Z" fill="#bcd3ee" />
    <path d="M190 108 L210 128 L198 126 L190 134 L180 124 L172 127Z M480 120 L498 138 L488 137 L480 144 L471 136 L463 139Z" fill="#fff" opacity=".9" />
    <g class="cloud" style="--cd:46s"><ellipse cx="120" cy="60" rx="34" ry="12" fill="#fff" /><ellipse cx="140" cy="52" rx="22" ry="12" fill="#fff" /></g>
    <g class="cloud" style="--cd:62s;--co:-30s"><ellipse cx="400" cy="40" rx="40" ry="11" fill="#fff" opacity=".9" /><ellipse cx="380" cy="33" rx="22" ry="11" fill="#fff" opacity=".9" /></g>
    {[[262, 238], [292, 250], [326, 232], [356, 246], [736, 240]].map(([x, h]) => (
      <path d={`M${x} ${h - 46} l14 26 h-7 l11 20 h-36 l11-20 h-7z`} fill="#2f6b4f" opacity=".9" />
    ))}

    <!-- yard -->
    <rect y="262" width="720" height="68" fill="#d9d4ca" />
    <rect y="262" width="720" height="4" fill="#c4bdb0" />
    {Array.from({ length: 9 }).map((_, i) => <rect x={250 + i * 26} y="316" width="14" height="3" rx="1.5" fill="#f7a81b" opacity=".8" />)}

    <!-- warehouse interior (behind the volunteers) -->
    <rect x="150" y="190" width="72" height="122" fill="#2b3445" />
    {[214, 246, 278].map(y => <rect x="152" y={y} width="68" height="3" fill="#4b5568" />)}
    {[[156, 199], [176, 199], [196, 199], [160, 231], [184, 231], [158, 263], [180, 263], [200, 263]].map(([x, y]) => <use href="#ct-carton" x={x} y={y} />)}

    <!-- container interior and open door (behind the volunteers) -->
    <rect x="500" y="186" width="14" height="124" fill="#0b1e3d" />
    <polygon points="500,186 482,172 482,290 500,302" fill="#174892" />
    {[488, 494].map(x => <rect x={x} y="182" width="2" height="104" fill="#0f3570" opacity=".7" />)}

    <!-- supervisor with clipboard -->
    <g transform="translate(452 296) scale(.86)">
      <rect x="-5" y="-22" width="5" height="22" rx="2" fill="#1f2a44" /><rect x="1" y="-22" width="5" height="22" rx="2" fill="#1f2a44" />
      <rect x="-9" y="-46" width="18" height="26" rx="6" fill="#f97316" /><rect x="-9" y="-36" width="18" height="3" fill="#fde68a" />
      <circle cy="-54" r="8" fill="#e7b48f" /><path d="M-9 -55 a9 9 0 0 1 18 0z" fill="#ffffff" /><rect x="-11" y="-56" width="22" height="3" rx="1.5" fill="#ffffff" />
      <rect x="-20" y="-44" width="11" height="14" rx="1.5" fill="#f8fafc" stroke="#94a3b8" />
      <g class="tick"><path d="M-6 -40 L-14 -34" stroke="#e7b48f" stroke-width="4" stroke-linecap="round" /></g>
    </g>

    <!-- volunteers -->
    {order.map(w => {
      const L = lanes[w.lane];
      return (
        <g transform={`translate(104 ${L.y}) scale(${L.s})`}>
          <g class="trip" style={`--d:${w.delay}s`}>
            <g>
              <g class="cargo">
                {w.cargo === 'bed' && <g>
                  <rect x="16" y="-27" width="74" height="5" rx="2" fill="#94a3b8" />
                  <rect x="18" y="-35" width="68" height="9" rx="3.5" fill="#ffffff" stroke="#cbd5e1" />
                  <rect x="70" y="-39" width="14" height="6" rx="3" fill="#bfdbfe" />
                  <rect x="86" y="-46" width="5" height="26" rx="2" fill="#64748b" /><rect x="14" y="-38" width="4" height="16" rx="2" fill="#64748b" />
                  <path d="M24 -22v15M82 -22v15" stroke="#64748b" stroke-width="3" />
                  <circle class="wheel" cx="24" cy="-4" r="4" fill="#334155" /><circle class="wheel" cx="82" cy="-4" r="4" fill="#334155" />
                </g>}
                {w.cargo === 'chair' && <g>
                  <path d="M14 -36 L18 -36 L22 -14 L42 -14" stroke="#475569" stroke-width="3" fill="none" stroke-linecap="round" />
                  <rect x="22" y="-20" width="20" height="5" rx="2" fill="#1d5bb8" /><rect x="18" y="-34" width="5" height="16" rx="2" fill="#1d5bb8" />
                  <g class="wheel"><circle cx="26" cy="-11" r="11" fill="none" stroke="#334155" stroke-width="2.5" /><path d="M26 -22v22M15 -11h22" stroke="#94a3b8" stroke-width="1" /></g>
                  <circle class="wheel" cx="44" cy="-3" r="3" fill="#334155" />
                </g>}
                {w.cargo === 'box' && <g><use href="#ct-carton" x="6" y="-48" transform="scale(1.15)" /></g>}
                {w.cargo === 'truck' && <g>
                  <path d="M14 -40 L20 -4 L36 -4" stroke="#475569" stroke-width="3" fill="none" stroke-linecap="round" />
                  <use href="#ct-carton" x="20" y="-19" /><use href="#ct-carton" x="18" y="-34" /><use href="#ct-carton" x="21" y="-49" />
                  <circle class="wheel" cx="22" cy="-4" r="4.5" fill="#334155" />
                </g>}
              </g>
              <g class="face"><g class="body">
                <rect x="-16" y="-62" width="32" height="62" fill="none" />
                <g class="leg a"><rect x="-4" y="-22" width="5" height="22" rx="2" fill="#1f2a44" /></g>
                <g class="leg b"><rect x="-1" y="-22" width="5" height="22" rx="2" fill="#263452" /></g>
                <rect x="-8" y="-45" width="16" height="25" rx="6" fill={w.vest} />
                <rect x="-8" y="-35" width="16" height="3" fill="#fde68a" opacity=".9" />
                <circle cy="-53" r="7.5" fill={w.skin} />
                <path d="M-8.5 -54 a8.5 8.5 0 0 1 17 0z" fill={w.hat} /><rect x="-6" y="-55.5" width="17" height="3" rx="1.5" fill={w.hat} />
                <path class="arm" d={w.cargo === 'box' ? 'M2 -41 L13 -37' : 'M2 -41 L15 -35'} stroke={w.skin} stroke-width="4" stroke-linecap="round" />
              </g></g>
            </g>
          </g>
        </g>
      );
    })}

    <!-- container (in front: the volunteers disappear inside) -->
    <polygon points="514,186 704,186 714,176 524,176" fill="#2a6ccc" />
    <rect x="514" y="186" width="190" height="124" rx="2" fill="url(#ct-box)" />
    <polygon points="704,186 714,176 714,300 704,310" fill="#0d2c5c" />
    {Array.from({ length: 13 }).map((_, i) => <rect x={520 + i * 14.4} y="192" width="6" height="104" rx="2" fill="#0f3570" opacity=".5" />)}
    <g transform="translate(536 216)">
      <rect width="96" height="38" rx="6" fill="#fff" opacity=".96" />
      <text x="9" y="17" font-family="Fraunces Variable, serif" font-size="13" font-weight="600" fill="#0a1b33">ROTARY</text>
      <text x="9" y="30" font-family="Plus Jakarta Sans Variable, sans-serif" font-size="7.5" font-weight="700" fill="#0067c8" letter-spacing="1.2">WORLD HELP</text>
      <circle cx="80" cy="19" r="10" fill="none" stroke="#f7a81b" stroke-width="3" stroke-dasharray="3.5 2.5" />
    </g>
    <text x="530" y="292" font-family="Plus Jakarta Sans Variable, sans-serif" font-size="7.5" font-weight="700" fill="#cfe3f7" letter-spacing="1.6">RWHU 40FT · COQUITLAM BC</text>
    <ellipse cx="612" cy="313" rx="104" ry="5" fill="#0a1b33" opacity=".18" />

    <!-- warehouse front wall (in front: the volunteers come out of it) -->
    <path fill-rule="evenodd" d="M10 150 L120 122 L232 150 V312 H10Z M150 190 V312 H222 V190Z" fill="#e8e1d3" />
    <path d="M6 152 L120 120 L236 152" stroke="#9a8f7c" stroke-width="6" fill="none" stroke-linejoin="round" />
    <rect x="146" y="180" width="80" height="12" rx="2" fill="#94a3b8" />{[183, 187].map(y => <rect x="148" y={y} width="76" height="1.5" fill="#64748b" />)}
    <rect x="22" y="158" width="120" height="28" rx="4" fill="#0a1b33" />
    <text x="82" y="171" text-anchor="middle" font-family="Plus Jakarta Sans Variable, sans-serif" font-size="7" font-weight="700" fill="#f7a81b" letter-spacing="1.4">ROTARY WORLD HELP</text>
    <text x="82" y="181" text-anchor="middle" font-family="Plus Jakarta Sans Variable, sans-serif" font-size="6" font-weight="600" fill="#cfe3f7" letter-spacing="1.2">WAREHOUSE · COQUITLAM</text>
    {[[36, 206], [80, 206]].map(([x, y]) => <g><rect x={x} y={y} width="30" height="22" rx="2" fill="#bcd3ee" stroke="#9a8f7c" stroke-width="2" /><path d={`M${x + 15} ${y}v22M${x} ${y + 11}h30`} stroke="#9a8f7c" stroke-width="1.5" /></g>)}
  </svg>
</div>

<style>
  .cartoon :global(svg) { overflow: hidden; border-radius: 1.5rem; }
  .cartoon g { transform-box: fill-box; }
  .trip { animation: trip 14s linear infinite; animation-delay: var(--d); }
  .face { transform-origin: 50% 100%; animation: face 14s step-end infinite; animation-delay: var(--d); }
  .cargo { animation: cargo 14s step-end infinite; animation-delay: var(--d); }
  .body { animation: bob .5s ease-in-out infinite alternate; }
  .leg { transform-origin: 50% 0; animation: stride .5s ease-in-out infinite alternate; }
  .leg.b { animation-direction: alternate-reverse; }
  .wheel { transform-box: fill-box; transform-origin: center; animation: spin 1s linear infinite; }
  .cloud { animation: drift var(--cd) linear infinite; animation-delay: var(--co, 0s); }
  .tick { transform-origin: 100% 0; animation: tick 1.6s ease-in-out infinite; }

  @keyframes trip { 0%, 4% { transform: translateX(0); } 44%, 52% { transform: translateX(370px); } 92%, 100% { transform: translateX(0); } }
  @keyframes face { 0% { transform: scaleX(1); } 48% { transform: scaleX(-1); } 96% { transform: scaleX(1); } }
  @keyframes cargo { 0% { opacity: 1; } 48% { opacity: 0; } 96% { opacity: 1; } }
  @keyframes bob { to { transform: translateY(-1.5px); } }
  @keyframes stride { from { transform: rotate(18deg); } to { transform: rotate(-18deg); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes drift { from { transform: translateX(-200px); } to { transform: translateX(760px); } }
  @keyframes tick { 0%, 60%, 100% { transform: rotate(0); } 75% { transform: rotate(-18deg); } 85% { transform: rotate(6deg); } }

  /* Only while on screen; still frame for reduced motion */
  .cartoon:not(.live) *, .cartoon:not(.live) { animation-play-state: paused !important; }
  @media (prefers-reduced-motion: reduce) { .cartoon * { animation: none !important; } }
</style>
