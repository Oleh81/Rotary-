---
import Icon from './Icon.astro';
import { nav, DONATE_URL, announcement } from '../data/site';
const bar = announcement.show && announcement.text.trim();
const barExt = /^https?:/.test(announcement.link);
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class={`site-header fixed inset-x-0 top-0 z-50 ${overlay ? 'text-white' : 'is-solid'}`} data-header data-overlay={overlay ? 'true' : 'false'}>
  {bar && (
    <div class="bg-gold text-ink">
      <p class="wrap flex min-h-9 flex-wrap items-center justify-center gap-x-3 py-1.5 text-center text-sm font-semibold">
        <span>{announcement.text}</span>
        {announcement.link && <a href={announcement.link} target={barExt ? '_blank' : undefined} rel={barExt ? 'noopener' : undefined} class="underline underline-offset-2 hover:no-underline">{announcement.linkLabel || 'Learn more'}</a>}
      </p>
    </div>
  )}
  <div class="wrap flex h-[72px] items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 shrink-0 rounded-xl" aria-label="Rotary World Help, home">
      <span class="grid h-12 w-[72px] place-items-center rounded-xl bg-white shadow-sm ring-1 ring-black/5">
        <img src="/brand/rwh-logo.webp" alt="" width="302" height="201" class="h-10 w-auto" />
      </span>
      <span class="hidden sm:block leading-tight">
        <span class="block font-display text-[1.15rem] font-semibold">Rotary World Help</span>
        <span class="block text-[.72rem] font-semibold tracking-[.14em] uppercase opacity-75">Greater Vancouver · Since 1993</span>
      </span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map(item => (
          <li class={`relative ${item.children ? 'has-drop' : ''}`}>
            <a href={item.href} class="u-link inline-flex items-center gap-1 px-3 py-2 text-[.95rem] font-semibold"
              aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}{item.children && <Icon name="chevron" size={14} />}
            </a>
            {item.children && (
              <div class="dropdown absolute left-0 top-full pt-2">
                <ul class="min-w-56 rounded-2xl bg-white p-2 text-ink shadow-[0_24px_60px_-20px_rgba(10,27,51,.35)] ring-1 ring-black/5">
                  {item.children.map(c => (
                    <li><a href={c.href} class="flex items-center justify-between rounded-xl px-4 py-3 text-[.95rem] font-semibold hover:bg-paper transition-colors"
                      aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}<Icon name="arrow" size={16} class="opacity-40" /></a></li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={DONATE_URL} class="btn btn-donate shimmer beam !min-h-11 !px-5" data-magnetic data-track="header"
        rel="noopener" target="_blank">
        <Icon name="heart" size={18} /> Donate<span class="sr-only"> (opens CanadaHelps in a new tab)</span>
      </a>
      <button type="button" class="lg:hidden grid size-11 place-items-center rounded-full ring-1 ring-current/30 cursor-pointer"
        aria-controls="mobile-menu" aria-expanded="false" data-menu-open aria-label="Open menu">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="menu-panel fixed inset-0 z-[60] bg-ink text-white on-dark lg:hidden overflow-y-auto" data-open="false" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="wrap flex h-[72px] items-center justify-between">
    <span class="font-display text-xl">Menu</span>
    <button type="button" class="grid size-11 place-items-center rounded-full ring-1 ring-white/30 cursor-pointer" data-menu-close aria-label="Close menu">
      <Icon name="x" size={22} />
    </button>
  </div>
  <nav aria-label="Mobile" class="wrap pb-10">
    <ul class="divide-y divide-white/10">
      <li class="menu-item" style="--i:0"><a href="/" class="flex items-center justify-between py-4 font-display text-3xl">Home</a></li>
      {nav.map((item, i) => item.children ? (
        <li class="menu-item py-4" style={`--i:${i + 1}`}>
          <a href={item.href} class="font-display text-3xl">{item.label}</a>
          <ul class="mt-3 grid gap-1 pl-1">
            {item.children.map(c => <li><a href={c.href} class="flex min-h-11 items-center gap-2 text-lg text-white/80 hover:text-gold"><Icon name="arrow" size={16} />{c.label}</a></li>)}
          </ul>
        </li>
      ) : (
        <li class="menu-item" style={`--i:${i + 1}`}><a href={item.href} class="flex items-center justify-between py-4 font-display text-3xl">{item.label}<Icon name="arrow" size={22} class="opacity-50" /></a></li>
      ))}
    </ul>
    <a href={DONATE_URL} target="_blank" rel="noopener" class="menu-item btn btn-donate shimmer mt-8 w-full !min-h-14 text-lg" style={`--i:${nav.length + 1}`} data-track="menu">
      <Icon name="heart" /> Donate through CanadaHelps
    </a>
  </nav>
</div>
