---
import durations from '../data/video-durations.json';
import { videos } from '../data/site';
interface Props { id: string; class?: string; ratio?: string; title?: string; caption?: string; light?: boolean }
const { id, class: cls = '', ratio = 'aspect-video', title, caption, light = false } = Astro.props;
const v = videos[id] ?? { id, title: title ?? '' };
const t = title ?? v.title;
const cap = caption ?? v.caption;
const sec = (durations as Record<string, number>)[id] ?? 0;
const dur = sec ? `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}` : '';
---
<figure class={`group ${cls}`}>
  <div class={`relative overflow-hidden rounded-3xl bg-ink ${ratio} shadow-[0_24px_60px_-30px_rgba(10,27,51,.6)]`} data-video={`/media/video/${id}.mp4`} data-title={t}>
    <img src={`/media/video/${id}.webp`} alt="" width="960" height="540" loading="lazy" decoding="async"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(.16,1,.3,1)] group-hover:scale-105" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent"></div>
    <button type="button" class="video-play absolute inset-0 flex items-center justify-center cursor-pointer" aria-label={`Play video: ${t}${dur ? ` (${dur})` : ''}`}>
      <span class="relative grid place-items-center size-16 md:size-20 rounded-full bg-white/95 text-ink shadow-2xl transition-transform duration-500 ease-[cubic-bezier(.34,1.56,.64,1)] group-hover:scale-110">
        <span class="absolute inset-0 rounded-full ring-2 ring-white/60 motion-safe:animate-ping [animation-duration:2.4s]" aria-hidden="true"></span>
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="translate-x-0.5"><polygon points="6 3 20 12 6 21 6 3"/></svg>
      </span>
    </button>
    {dur && <span class="absolute right-3 top-3 rounded-full bg-ink/70 px-2.5 py-1 text-xs font-semibold text-white tabular backdrop-blur">{dur}</span>}
  </div>
  {(t || cap) && (
    <figcaption class="mt-3">
      <span class={`block font-semibold leading-snug ${light ? 'text-white' : 'text-ink'}`}>{t}</span>
      {cap && <span class={`mt-1 block text-sm ${light ? 'text-white/70' : 'text-stone'}`}>{cap}</span>}
    </figcaption>
  )}
</figure>
