---
// 3D isometric loading scene (three.js, loaded only when the section scrolls near the screen).
---
<div class="relative aspect-[4/3] md:aspect-[2/1] w-full bg-[linear-gradient(180deg,#dbe8f7_0%,#eef3f9_55%,#e7e1d6_100%)]" data-scene>
  <canvas class="absolute inset-0 h-full w-full" role="img"
    aria-label="Animation: volunteers and a forklift move hospital beds, wheelchairs, an X-ray machine, incubators, a dental chair, computers and boxes of supplies from the Rotary World Help warehouse into a shipping container."></canvas>
</div>

<script>
  function start(el: HTMLElement) {
    const canvas = el.querySelector('canvas')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let scene: { play(): void; pause(): void } | null = null;
    let visible = false;
    const sync = () => { if (!scene) return; visible && !document.hidden ? scene.play() : scene.pause(); };
    const boot = async () => {
      try {
        const { startLoadingScene } = await import('../scripts/loading3d');
        scene = startLoadingScene(canvas, { still });
        el.dataset.ready = '1';
        sync();
      } catch { /* no WebGL: the gradient stays */ }
    };
    let booted = false;
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !booted) { booted = true; boot(); }
      sync();
    }, { rootMargin: '200px' }).observe(el);
    document.addEventListener('visibilitychange', sync);
  }
  document.querySelectorAll<HTMLElement>('[data-scene]').forEach(start);
</script>
