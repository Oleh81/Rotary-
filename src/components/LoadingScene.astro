---
// Looping animation of a container loading (rendered video, plays without loading the page's main thread).
---
<div class="relative aspect-video w-full bg-[#f3eee6]" data-loop>
  <video class="absolute inset-0 h-full w-full object-cover" muted loop playsinline preload="none"
    poster="/media/video/loading-loop.webp" width="1280" height="720"
    aria-label="Animation: volunteers and forklifts move hospital beds, wheelchairs, an X-ray machine, incubators, a dental chair, computers and boxes of supplies from the Rotary World Help warehouse into a shipping container.">
    <source src="/media/video/loading-loop.mp4" type="video/mp4" />
  </video>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-loop]').forEach(el => {
    const v = el.querySelector('video')!;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let visible = false;
    const sync = () => { if (visible && !document.hidden) v.play().catch(() => {}); else v.pause(); };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible && v.preload === 'none') { v.preload = 'auto'; } sync(); }, { rootMargin: '200px' }).observe(el);
    document.addEventListener('visibilitychange', sync);
  });
</script>
